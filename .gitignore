# Ignore everything by default
*

# Keep repository metadata needed for Git behavior
!.gitignore

# Allow only productive files in this repository
!AGENTS.md
!install_agents.py
!README.md
!.pre-commit-config.yaml
!fragments/
!fragments/*.md
!.github/
!.github/workflows/
!.github/workflows/*.yml
!scripts/
!scripts/*.py
!tests/
!tests/*.py
