# Deny everything by default
*

# Keep this file so rules remain versioned
!.gitignore

# Top-level files required by this repository
!AGENTS.md
!README.md
!install_agents.py
!.pre-commit-config.yaml
!config.yaml

# GitHub workflow(s)
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Documentation fragments (markdown only)
!fragments/
!fragments/**/*.md

# Automation scripts (python only)
!scripts/
!scripts/**/*.py

# Tests (python only)
!tests/
!tests/**/*.py
